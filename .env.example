# ============================================================
# LLM Cost Optimization Gateway — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Gateway Settings ---
GATEWAY_SECRET_KEY=your-super-secret-key-change-this-in-production
GATEWAY_ADMIN_TOKEN=admin-token-change-this
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_DEBUG=true
GATEWAY_LOG_LEVEL=info

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./gateway.db

# --- LLM Provider API Keys (add any you have) ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...

# --- Semantic Cache Settings ---
CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_MAX_SIZE=10000
CACHE_TTL_SECONDS=86400

# --- Cost Limits ---
DEFAULT_MONTHLY_BUDGET_USD=10.0
HARD_LIMIT_ENABLED=true

# --- Rate Limiting ---
DEFAULT_RPM=60
DEFAULT_TPM=100000

# --- Mock Mode (no real API keys needed for testing) ---
MOCK_PROVIDERS=false
